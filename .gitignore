# ---- 数据库与运行时数据（绝不入库）----
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/ip_system.db*

# ---- 上传文件（文档 / 商标图样等）----
# 忽略目录内容但保留目录本身，运行时自动创建
backend/uploads/*
!backend/uploads/.gitkeep

# ---- 前端构建产物与依赖 ----
backend/static/
frontend/dist/
frontend/node_modules/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log
backend/backend.log
nul

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
